Options -Indexes -MultiViews

# -----------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS — only sent over HTTPS so HTTP installs (local dev, non-SSL hosting)
    # are never affected. Remove the <If> block entirely if you want to disable HSTS.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP: style-src uses 'unsafe-inline' because the admin UI has many hardcoded
    # inline style= attributes. No user-controlled data reaches any style= attribute
    # (all dynamic values are either (int)-cast or drawn from a hardcoded map).
    # To remove 'unsafe-inline', migrate all inline styles to CSS classes and then
    # switch to a per-request nonce or hash-based approach.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-lfZvxb5T4sGLkAT0mD3Vb+Uc8DCNaZf6KEuzEkUi0eA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Remove server fingerprinting
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------
# Block direct access to sensitive file types
# -----------------------------------------------------------------------
<FilesMatch "\.(env|log|sql|md|lock|gitignore|gitkeep|json|xml|ini|cfg|bak|old|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dot-files (except .htaccess itself)
<FilesMatch "^\.(?!htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------
# Rewrite rules
# -----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set this to the URL path of the public/ directory relative to the
    # domain root. For a document-root install use: RewriteBase /
    # For a subdirectory install adjust accordingly, e.g.: RewriteBase /mysite/public/
    RewriteBase /luster/public/

    # Serve real files and directories directly (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect old standalone scripts to their new subdirectory locations
    RewriteRule ^install\.php$ /luster/public/install/ [R=301,L]
    RewriteRule ^migrate\.php$ /luster/public/migrate/ [R=301,L]

    # Redirect old display-codes URL to embed-codes (permanent, preserves query string)
    RewriteRule ^admin/display-codes$ /luster/public/admin/embed-codes [R=301,L,QSA]

    # Redirect old saved-emails URL to new-email-template (permanent, preserves query string)
    RewriteRule ^admin/saved-emails(/.*)?$ /luster/public/admin/new-email-template$1 [R=301,L,QSA]

    # Route /admin and /admin/* to the admin front controller
    RewriteRule ^admin(/.*)?$ admin.php [L,QSA]

    # Route everything else to the public front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# -----------------------------------------------------------------------
# PHP settings (shared hosting safety net)
# -----------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite Strict
    php_value session.use_strict_mode 1
    php_flag session.use_only_cookies On
</IfModule>

# -----------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Fonts and CSS: cache for 1 year (bump filename query string on deploy)
    <FilesMatch "\.(woff2|woff|ttf|otf|eot|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # JS and images: cache for 1 week
    <FilesMatch "\.(js|png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
