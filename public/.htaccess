Options -Indexes -MultiViews

# -----------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS — only sent over HTTPS so HTTP installs (local dev, non-SSL hosting)
    # are never affected. Remove the <If> block entirely if you want to disable HSTS.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </If>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP: style-src uses 'unsafe-inline' because the admin UI has many hardcoded
    # inline style= attributes. No user-controlled data reaches any style= attribute
    # (all dynamic values are either (int)-cast or drawn from a hardcoded map).
    # To remove 'unsafe-inline', migrate all inline styles to CSS classes and then
    # switch to a per-request nonce or hash-based approach.
    # script-src has no exceptions — every admin script is an external asset under
    # public/assets/js/. Keep it that way; a new inline <script> or onclick=
    # attribute is silently blocked by this policy rather than raising an error,
    # so it's easy to miss in testing. Wire new behavior through admin.js instead.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Allow the embed preview endpoint to be framed by this same-origin admin
    # panel. Uses %{THE_REQUEST} (not %{REQUEST_URI}, which is already
    # rewritten to admin.php by the time this <If> evaluates - see the News
    # Feed block below for the full explanation) and both "Header unset" +
    # "Header always unset" before each "Header always set" (see the same
    # block for why a plain "Header always set" alone doesn't reliably
    # replace a header SecurityHeaders.php already sent). This block
    # previously used %{REQUEST_URI} with neither unset form and never
    # actually took effect - confirmed via curl against a live request
    # (X-Frame-Options still came back DENY on this route) before this fix.
    <If "%{THE_REQUEST} =~ m#/admin/embed-codes/preview(?=[?\s]|$)#">
        Header unset X-Frame-Options
        Header always unset X-Frame-Options
        Header always set X-Frame-Options "SAMEORIGIN"
        Header unset Content-Security-Policy
        Header always unset Content-Security-Policy
        Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    </If>
    # Allow the News Feed composer's live preview to load whatever http(s)://
    # image URL the admin just typed. NewsfeedBodySanitizer accepts both http
    # and https for src (ValidatorField::httpUrl()'s existing rule) - the CSP
    # here must allow both too, or a valid http:// image would render for
    # real once saved but silently fail to load in this preview only. This
    # only affects whether the admin's own browser can fetch it while
    # previewing, not what gets saved or rendered on the live public site
    # (never under this admin-only CSP at all). Mirrors
    # SecurityHeaders::imgSrcDirective() - keep both in sync.
    #
    # Uses %{THE_REQUEST} (the original raw request line), not %{REQUEST_URI} -
    # by the time this <If> evaluates, REQUEST_URI has already been rewritten
    # by the RewriteRule below to the internal target (admin.php), so matching
    # against it here never fires. THE_REQUEST still holds the original path.
    #
    # The (?=[?\s]|$) lookahead after the alternation is required - without
    # it, "\d+/add" and "entry/\d+/edit" match as a *prefix* of a longer path
    # segment (confirmed matching /admin/newsfeed/1/additional,
    # /admin/newsfeed/entry/1/edit-old, and /admin/newsfeed/collective/additional,
    # none of which are real routes), since nothing anchors the alternatives
    # to the end of that path segment. The lookahead requires whatever
    # follows to be a literal "?" (query string), whitespace (THE_REQUEST's
    # trailing " HTTP/1.1"), or end of string (REQUEST_URI with no query
    # string) - i.e. the path segment must actually end there.
    #
    # Both "Header unset" and "Header always unset" are required, in this
    # order, before the final "Header always set" - verified empirically
    # (curl against a live request) that PHP's own Content-Security-Policy
    # header (SecurityHeaders::apply(), sent for non-Apache deployments) is
    # NOT replaced by a single "Header always set" the way the doc comment
    # in SecurityHeaders.php used to claim; it lands as a second, separate
    # header. Per the CSP spec, browsers enforce the intersection of every
    # delivered policy, so two different img-src values silently collapse to
    # the stricter one - the relaxation would have no real effect without
    # both unset lines clearing every prior instance first.
    <If "%{THE_REQUEST} =~ m#/admin/newsfeed/(collective/add|entry/\d+/edit|\d+/add)(?=[?\s]|$)#">
        Header unset Content-Security-Policy
        Header always unset Content-Security-Policy
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    </If>
    # Remove server fingerprinting
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------
# Block direct access to sensitive file types
# -----------------------------------------------------------------------
<FilesMatch "\.(env|log|sql|md|lock|gitignore|gitkeep|json|xml|ini|cfg|bak|old|tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block dot-files (except .htaccess itself)
<FilesMatch "^\.(?!htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------
# Rewrite rules
# -----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set this to the URL path of the public/ directory relative to the domain root.
    # If your document root points directly at public/: RewriteBase /
    # If Luster lives in a subdirectory: RewriteBase /that/subdirectory/public/
    # Uncomment if clean URLs 404 after moving this install or syncing via FTP:
    # RewriteBase /luster/public/

    # Serve real files and directories directly (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect old display-codes URL to embed-codes (permanent, preserves query string)
    RewriteRule ^admin/display-codes$ admin/embed-codes [R=301,L,QSA]

    # Redirect old saved-emails URL to new-email-template (permanent, preserves query string)
    RewriteRule ^admin/saved-emails(/.*)?$ admin/new-email-template$1 [R=301,L,QSA]

    # Route /admin and /admin/* to the admin front controller
    RewriteRule ^admin(/.*)?$ admin.php [L,QSA]

    # Route everything else to the public front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# -----------------------------------------------------------------------
# PHP settings (shared hosting safety net)
# -----------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite Strict
    php_value session.use_strict_mode 1
    php_flag session.use_only_cookies On
</IfModule>

# -----------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Fonts and CSS: cache for 1 year (bump filename query string on deploy)
    <FilesMatch "\.(woff2|woff|ttf|otf|eot|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # JS and images: cache for 1 week
    <FilesMatch "\.(js|png|jpg|jpeg|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------
# Compression
# -----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
