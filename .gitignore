# Composer
/vendor/
composer.lock

# Live config — never commit
/config/app.php

# Runtime storage
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# User uploads — keep the directory and its .htaccess, not the files
/public/uploads/*
!/public/uploads/.htaccess

# Developer utilities — not part of the deployable application
/public/theme-preview.html
/public/assets/js/theme-preview.js

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test artefacts
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# Environment file (if ever adopted)
.env
audit/
