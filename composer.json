{
    "name": "luster/luster",
    "description": "Fanlisting management script",
    "version": "1.0.6",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/starceress/luster",
    "authors": [
        {
            "name": "spyderfang",
            "homepage": "https://github.com/starceress"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Luster\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Luster\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
